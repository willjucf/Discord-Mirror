# =============================================================================
# Copy this file to `.env` and fill it in.  `.env` is gitignored — never commit
# it, and never share these values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the token of the Discord account that can READ the source channels.
#
# Discord web client (not the desktop app):
#   F12 -> Network tab -> open or send any message -> click a request to /api/v*/
#   -> Headers -> copy the value of the `authorization` header.
# -----------------------------------------------------------------------------
DISCORD_TOKEN=paste_your_token_here

# -----------------------------------------------------------------------------
# REQUIRED — one webhook URL per destination channel.
#
# In the DESTINATION server:
#   Server Settings -> Integrations -> Webhooks -> New Webhook
#   -> pick the channel -> Copy Webhook URL
#
# The name here is yours to choose; reference it from config.json as
# "webhook": "env:WEBHOOK_MAIN".  Add as many as you have destination channels.
# -----------------------------------------------------------------------------
WEBHOOK_MAIN=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx
# WEBHOOK_ANNOUNCEMENTS=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# debug | info | warn | error      (debug prints why messages were skipped)
LOG_LEVEL=info

# Path to the config file. Defaults to ./config.json
# CONFIG_PATH=./config.json
